{
  "name": "acts-bible-school-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc -p tsconfig.server.json",
    "dev:emulators": "VITE_USE_FIREBASE_EMULATORS=true vite",
    "emulators": "npx firebase-tools@latest emulators:start --only auth,firestore --project acts-bible-school-portal",
    "seed:emulators": "node scripts/seed-emulators.mjs",
    "db:local": "node scripts/db-local.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "migrate:export": "tsx scripts/migrate/export.ts",
    "migrate:load": "tsx scripts/migrate/load.ts",
    "migrate:verify": "tsx scripts/migrate/verify.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.9",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.7.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.563.0",
    "pg": "^8.23.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^5.2.0",
    "tsx": "^4.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@vercel/node": "^16.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^17.10.0-beta.17",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": "22.x"
  }
}
