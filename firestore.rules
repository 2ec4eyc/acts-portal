rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function callerDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function callerRole() {
      return exists(callerDoc()) ? get(callerDoc()).data.role : null;
    }
    function isAdmin() {
      return isAuthenticated() &&
        (("email" in request.auth.token && request.auth.token.email == "actsportal2026@gmail.com") ||
         callerRole() == 'admin');
    }
    function isTeacher() {
      return isAuthenticated() && callerRole() == 'teacher';
    }
    function isExecutive() {
      return isAuthenticated() && callerRole() in ['president', 'vice president'];
    }
    function isStaff() {
      return isAdmin() || isTeacher() || isExecutive();
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['admin', 'student', 'president', 'vice president', 'teacher'];
    }

    // Fields a user may change on their own profile. Everything else
    // (role, status, grades, editHistory, enrollment fields, ...) is
    // managed by staff. Keep in sync with PROFILE_SELF_EDITABLE_FIELDS in index.tsx.
    function selfEditableFields() {
      return [
        'firstName', 'middleName', 'lastName', 'fullName', 'photoURL',
        'contactNumber', 'gender', 'birthDate',
        'address', 'city', 'province', 'postalCode',
        'church', 'pastorName',
        'holyGhostBaptismDate', 'holyGhostBaptismLocation',
        'waterBaptismDate', 'waterBaptismLocation',
        'emergencyFirstName', 'emergencyLastName',
        'emergencyRelationship', 'emergencyContactNumber',
        'currentSessionId'
      ];
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();

      // Self-creation (first login without a profile) is only allowed as a plain student.
      allow create: if isValidUser(request.resource.data) &&
        request.resource.data.uid == userId &&
        (isAdmin() ||
         (isOwner(userId) &&
          request.resource.data.role == 'student' &&
          request.resource.data.status == 'Active' &&
          request.resource.data.grades == []));

      allow update: if isValidUser(request.resource.data) &&
        request.resource.data.uid == resource.data.uid && (
          isAdmin() ||
          // Executives manage accounts and records but cannot change roles.
          (isExecutive() && !changedKeys().hasAny(['role', 'uid'])) ||
          // Teachers may only record grades for students.
          (isTeacher() && resource.data.role == 'student' &&
           changedKeys().hasOnly(['grades', 'editHistory'])) ||
          (isOwner(userId) && changedKeys().hasOnly(selfEditableFields()))
        );

      allow delete: if isAdmin();
    }
    match /archived_users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create, update, delete: if isAdmin();
    }
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    match /trash/{courseId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /uploaded_files/{fileId} {
      allow read: if isAuthenticated();
      allow create: if isStaff() && request.resource.data.teacherUid == request.auth.uid;
      allow update: if isAdmin() ||
        (isStaff() && resource.data.teacherUid == request.auth.uid &&
         request.resource.data.teacherUid == request.auth.uid);
      allow delete: if isAdmin() || (isStaff() && resource.data.teacherUid == request.auth.uid);
    }
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isStaff();
    }
  }
}
