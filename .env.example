# Firebase web config (public values; bundled into the client).
# If unset, src/lib/firebase.ts falls back to the acts-bible-school-portal project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to use the local Firebase emulators (npm run dev:emulators does this for you).
VITE_USE_FIREBASE_EMULATORS=false
