# Firebase web config (public values; bundled into the client).
# If unset, src/lib/firebase.ts falls back to the acts-bible-school-portal project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to use the local Firebase emulators (npm run dev:emulators does this for you).
VITE_USE_FIREBASE_EMULATORS=false

# --- Server (Vercel Functions, migrations). Set in Vercel; locally put them in .env.local. ---
# Neon's Vercel integration sets these two. Local: npm run db:local prints the URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/acts
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@127.0.0.1:5433/acts

# Firebase Admin, for verifying sign-in tokens. Only the project id is required; with the
# service-account email and key the API also rejects revoked sessions.
FIREBASE_PROJECT_ID=acts-bible-school-portal
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Preview deploys only run migrations when this is true (enable once previews use Neon branches).
MIGRATE_ON_PREVIEW=false
